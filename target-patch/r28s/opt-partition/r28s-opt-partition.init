#!/bin/sh /etc/rc.common
# R28S: turn the leftover eMMC space into a big partition and mount it at /opt.
#
# Two-stage by design: the running system's rootfs lives on the very same disk, so
# the kernel refuses to re-read the partition table while it is in use (EBUSY).
# We therefore write the table, reboot ONCE, and only then mkfs + mount.
#
# ============================ SAFETY (2026-10-10 fix) ============================
# The previous revision rebooted whenever the new partition node was still missing,
# WITHOUT ever checking whether the sfdisk write had actually succeeded.  `sfdisk`
# output was piped into `logger`, so its exit status was discarded too.  Whenever the
# write did not take effect (invalid/overlapping entry rejected by the kernel) the
# node never appeared -> the board rebooted every ~30 s forever:
#
#     [20.4] r8169 eth1: Link is Up        <- LAN comes up
#     [21.6] procd: - shutdown -           <- this script's `reboot`
#     [30.8] reboot: Restarting system
#
# which the user perceives as "the LAN port keeps dropping".
#
# Now:
#   1. the free region is derived from sysfs (deterministic, no `sfdisk -F` parsing)
#   2. the MBR partition-table bytes are hashed before/after the write
#   3. we reboot ONLY if the table really changed, and at most ONCE (persistent flag)
#   4. on any failure we log loudly (syslog + serial console + /etc/r28s-opt.log)
#      and give up -- the board stays up and usable instead of looping
#
# Manual retry after a failure:  rm -f /etc/.r28s-opt-*  &&  reboot
START=99

LOGFILE=/etc/r28s-opt.log
FLAG_TABLE_WRITTEN=/etc/.r28s-opt-table-written
FLAG_REBOOTED=/etc/.r28s-opt-rebooted

msg() {
	logger -t r28s-opt "$*"
	echo "r28s-opt: $*" >>"$LOGFILE" 2>/dev/null
	# mirror onto the serial console so a TTL capture explains itself
	[ -w /dev/console ] && echo "r28s-opt: $*" >/dev/console 2>/dev/null
	return 0
}

# partition-table area of the MBR only (offset 446, 64 bytes): stable across boots
mbr_hash() {
	dd if="$1" bs=1 skip=446 count=64 2>/dev/null | md5sum 2>/dev/null | awk '{print $1}'
}

# print "<num> <start_sectors> <size_sectors>" for every partition of the disk
part_info() {
	local d="${1##*/}" p n
	for p in /sys/class/block/${d}p*/; do
		[ -r "${p}start" ] || continue
		n="${p%/}"; n="${n##*p}"
		echo "$n $(cat "${p}start" 2>/dev/null) $(cat "${p}size" 2>/dev/null)"
	done
}

start() {
	for c in sfdisk mkfs.ext4 blkid lsblk uci dd md5sum blockdev; do
		command -v "$c" >/dev/null 2>&1 || { msg "missing $c, skip"; return 0; }
	done

	# /opt is already a dedicated mount point -> nothing to do (idempotent)
	if awk '$2=="/opt"{f=1}END{exit !f}' /proc/mounts 2>/dev/null; then
		rm -f "$FLAG_TABLE_WRITTEN" "$FLAG_REBOOTED"
		return 0
	fi

	# locate the disk that carries /rom (i.e. the eMMC we booted from)
	local ROMPART DISK
	ROMPART=$(lsblk -nr -o PATH,MOUNTPOINT 2>/dev/null | awk '$2=="/rom"{print $1; exit}')
	case "$ROMPART" in
	/dev/mmcblk*p*) DISK="${ROMPART%p*}" ;;
	*)
		DISK=""
		for d in /dev/mmcblk0 /dev/mmcblk1 /dev/mmcblk2; do
			[ -b "${d}p2" ] && { DISK="$d"; break; }
		done
		;;
	esac
	[ -b "$DISK" ] || { msg "system disk not found, skip"; return 0; }
	msg "system disk = $DISK"

	# reuse an existing LABEL=opt partition only when its node really exists
	local PART
	PART=$(blkid -L opt 2>/dev/null)
	[ -n "$PART" ] && [ ! -b "$PART" ] && { msg "LABEL=opt -> $PART but node is missing, ignoring"; PART=""; }

	if [ -z "$PART" ]; then
		local DISKSZ END START_SECT FREE_SECTS NEWPART TBL_BEFORE TBL_AFTER
		DISKSZ=$(blockdev --getsz "$DISK" 2>/dev/null)
		case "$DISKSZ" in
		''|*[!0-9]*) msg "cannot read disk size, skip"; return 0 ;;
		esac

		END=0
		NEWPART=0
		while read -r n st sz; do
			[ -n "$n" ] || continue
			[ "$n" -gt "$NEWPART" ] && NEWPART="$n"
			[ $((st + sz)) -gt "$END" ] && END=$((st + sz))
		done <<EOF
$(part_info "$DISK")
EOF
		NEWPART=$((NEWPART + 1))

		# 1 MiB align the new start (2048 x 512B sectors)
		START_SECT=$(( (END + 2047) / 2048 * 2048 ))
		FREE_SECTS=$(( DISKSZ - START_SECT ))
		msg "layout: disk=${DISKSZ}s used_end=${END}s new_start=${START_SECT}s free=${FREE_SECTS}s part=p${NEWPART}"
		if [ "$FREE_SECTS" -lt 524288 ]; then
			msg "less than 256MiB free, skip creating /opt"
			return 0
		fi

		PART="${DISK}p${NEWPART}"
		TBL_BEFORE=$(mbr_hash "$DISK")
		msg "writing partition ${NEWPART} @${START_SECT}s size=${FREE_SECTS}s"
		echo "${START_SECT},${FREE_SECTS},L,*" | sfdisk --force --no-reread --append "$DISK" 2>&1 | logger -t r28s-opt
		sync
		TBL_AFTER=$(mbr_hash "$DISK")

		# fallback if sfdisk changed nothing: try parted once
		if [ "$TBL_BEFORE" = "$TBL_AFTER" ] && command -v parted >/dev/null 2>&1; then
			msg "sfdisk changed nothing, trying parted fallback"
			parted -s -a none "$DISK" unit s mkpart primary "${START_SECT}s" 100% 2>&1 | logger -t r28s-opt
			sync
			TBL_AFTER=$(mbr_hash "$DISK")
		fi

		if [ "$TBL_BEFORE" = "$TBL_AFTER" ]; then
			msg "ABORT: partition table was NOT modified (hash=$TBL_AFTER)"
			msg "ABORT: /opt is left unconfigured; board keeps running (no reboot)"
			return 0
		fi
		: >"$FLAG_TABLE_WRITTEN"

		if [ ! -b "$PART" ]; then
			if [ -e "$FLAG_REBOOTED" ]; then
				msg "ABORT: table changed but kernel still refuses $PART after the one allowed reboot"
				msg "ABORT: giving up instead of looping -- check 'dmesg | grep mmcblk' on the next boot"
				logger -t r28s-opt "verify: $(sfdisk --verify "$DISK" 2>&1 | head -n 3)"
				return 0
			fi
			: >"$FLAG_REBOOTED"
			msg "partition table updated -> rebooting ONCE so the kernel re-reads it"
			sleep 2
			reboot
			return 0
		fi
		msg "kernel already sees $PART"
	fi

	[ -b "$PART" ] || { msg "$PART not present, abort"; return 0; }

	# ---- mkfs + mount ----
	local FS UUID
	FS=$(blkid -o value -s TYPE "$PART" 2>/dev/null)
	if [ "$FS" != "ext4" ]; then
		msg "mkfs.ext4 -L opt $PART"
		mkfs.ext4 -F -L opt "$PART" 2>&1 | logger -t r28s-opt
		sync
	fi

	UUID=$(blkid -o value -s UUID "$PART" 2>/dev/null)
	if [ -z "$UUID" ]; then
		msg "ABORT: no UUID for $PART, /opt unconfigured"
		return 0
	fi

	mkdir -p /opt
	uci set fstab.@global[0].anon_mount='0'
	uci set fstab.@global[0].anon_swap='0'
	# drop every auto-mount entry except /opt (keep /opt if it is already there)
	local idx=0 t
	while uci -q get "fstab.@mount[$idx]" >/dev/null 2>&1; do
		t=$(uci -q get "fstab.@mount[$idx].target")
		if [ "$t" = "/opt" ]; then
			idx=$((idx + 1))
		else
			uci -q del "fstab.@mount[$idx]"
		fi
	done
	if ! uci -q show fstab | grep -q "\.target='\/opt'"; then
		uci add fstab mount
		uci set fstab.@mount[-1].target="/opt"
		uci set fstab.@mount[-1].uuid="$UUID"
		uci set fstab.@mount[-1].enabled="1"
	fi
	uci commit fstab

	for m in /mnt/mmcblk0p1 /mnt/mmcblk0p3 /mnt/mmcblk2p1 /mnt/mmcblk2p3; do
		umount "$m" 2>/dev/null
		findmnt -n "$m" >/dev/null 2>&1 || rmdir "$m" 2>/dev/null
	done

	mount -t ext4 -o noatime "UUID=$UUID" /opt 2>/dev/null || mount "$PART" /opt 2>/dev/null
	if awk '$2=="/opt"{f=1}END{exit !f}' /proc/mounts 2>/dev/null; then
		rm -f "$FLAG_TABLE_WRITTEN" "$FLAG_REBOOTED"
		msg "$PART ($UUID) mounted at /opt"
	else
		msg "ABORT: mount of $PART at /opt failed"
	fi
	return 0
}
