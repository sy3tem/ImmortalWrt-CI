#!/bin/sh
#
# 启用 iStoreOS 的 quickstart 守护进程（网络向导 / 首页卡片的后端）。
#
# 链路是这样的，uhttpd 与 LuCI 都不需要改：
#
#   前端 index.js
#     const du = "/cgi-bin/luci/istore"
#     Q = (a, o) => (a.indexOf("//") == -1 && (a = `${du}${a}`), ...)
#     ↓ 请求 /cgi-bin/luci/istore/guide/gateway-router/
#   LuCI controller
#     /usr/lib/lua/luci/controller/istore_backend.lua  entry{"istore"}
#     连 127.0.0.1:3038，转发 REQUEST_URI，并从 sysauth cookie 取出 sid、
#     用 ubus 查回 token，注入 X-Forwarded-Sid / X-Forwarded-Token
#     ↓
#   /usr/sbin/quickstart serve（本脚本负责拉起来）
#
# 早期版本误以为前端请求裸 /guide，给 uhttpd 打了 proxy_prefix 补丁并配了
# 十个前缀。那是错的，而且有害：一旦有谁把 /cgi-bin/luci/istore 也加进去，
# 请求会绕过 LuCI，X-Forwarded-Sid 就没了，后端 secureHTTP 一律回 403。
# 这里顺手把历史遗留的 proxy_prefix 清掉，保证走原生转发。

if uci -q get uhttpd.main >/dev/null 2>&1 &&
	[ -n "$(uci -q get uhttpd.main.proxy_prefix 2>/dev/null)" ]; then
	uci -q delete uhttpd.main.proxy_prefix
	uci -q commit uhttpd
	/etc/init.d/uhttpd restart 2>/dev/null
fi

# ipk 里的 init 脚本是 START=92，rc.d 链接首次启动时还没生成，手动 enable 一次
/etc/init.d/quickstart enable 2>/dev/null
/etc/init.d/quickstart start 2>/dev/null

# LuCI 的 controller 索引可能在守护进程起来之前就生成过，清一次让它重建，
# 否则菜单里的 quickstart 首页可能指向旧条目
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*

exit 0
