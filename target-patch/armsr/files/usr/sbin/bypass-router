#!/bin/sh
#
# bypass-router —— 把这台设备切成「旁路由」(single-arm gateway)
#
# 做的事和 iStoreOS「网络向导 → 配置旁路由网络」那一页完全一样：
#   lan 改静态地址，网关/DNS 指向主路由，关闭本机的 DHCPv4 / DHCPv6 服务，
#   lan 区域放行管理访问（默认不做 NAT）。
#
# 为什么不直接用那个向导页：
#   它保存时 POST /guide/gateway-router/，这条接口由 iStoreOS 的 quickstart
#   Go 守护进程提供。本固件没有编入该守护进程（不在任何 feed 里，闭源、
#   也没有 aarch64 发布），请求打到 uhttpd 没人接，于是返回 500 ——
#   页面上就是「网络异常：500 connect failed」。
#
# 用法:
#   bypass-router 192.168.3.251/24 192.168.3.1 223.5.5.5
#   bypass-router 192.168.3.251                 # 网关取自当前 DHCP 租约
#   bypass-router 192.168.3.251 192.168.3.1 223.5.5.5 --nat
#
# 参数:
#   1  <ip[/prefix]>  lan 静态地址，prefix 省略按 /24
#   2  [gateway]      默认网关（主路由地址），省略则从当前租约推断
#   3  [dns]          DNS，省略则与网关相同
#   --nat             在 lan 区域开 masq（部分无线热点/上级路由需要）
#
# 注意: 切换地址会让当前 SSH/Web 连接断开，请用新地址重新访问。

set -e

usage() {
	sed -n '3,26p' "$0" | sed 's/^# \{0,1\}//'
}

[ -n "$1" ] || { usage; exit 1; }
case "$1" in
	-h|--help) usage; exit 0 ;;
esac

NAT=0
for a in "$@"; do
	[ "$a" = "--nat" ] && NAT=1
done

IPCIDR="$1"
GW="$2"
DNS="$3"
[ "$GW" = "--nat" ] && GW=""
[ "$DNS" = "--nat" ] && DNS=""

case "$IPCIDR" in
	*/*) IP="${IPCIDR%%/*}"; PFX="${IPCIDR##*/}" ;;
	*)   IP="$IPCIDR"; PFX=24 ;;
esac

case "$PFX" in
	''|*[!0-9]*) echo "错误: 前缀长度不合法: $PFX"; exit 1 ;;
esac
[ "$PFX" -ge 1 ] && [ "$PFX" -le 32 ] || { echo "错误: 前缀长度需在 1-32 之间"; exit 1; }

echo "$IP" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || { echo "错误: IP 地址不合法: $IP"; exit 1; }

MASK="$(awk -v p="$PFX" 'BEGIN {
	n = 0
	for (i = 0; i < 32; i++) if (i < p) n += 2 ^ (31 - i)
	printf "%d.%d.%d.%d", int(n / 16777216) % 256, int(n / 65536) % 256, int(n / 256) % 256, n % 256
}')"

if [ -z "$GW" ]; then
	GW="$(ubus call network.interface.lan status 2>/dev/null \
		| jsonfilter -e '@.route[0].nexthop' 2>/dev/null)"
fi
[ -n "$DNS" ] || DNS="$GW"

echo "旁路由配置:"
echo "  地址   $IP/$PFX  ($MASK)"
echo "  网关   ${GW:-<未设置>}"
echo "  DNS    ${DNS:-<未设置>}"
echo "  NAT    $([ "$NAT" -eq 1 ] && echo 开启 || echo 关闭)"
echo

uci -q set network.lan.proto='static'
uci -q set network.lan.ipaddr="$IP"
uci -q set network.lan.netmask="$MASK"
uci -q delete network.lan.ip6assign
if [ -n "$GW" ]; then
	uci -q set network.lan.gateway="$GW"
else
	uci -q delete network.lan.gateway
fi
if [ -n "$DNS" ]; then
	uci -q set network.lan.dns="$DNS"
else
	uci -q delete network.lan.dns
fi
uci -q commit network

# 旁路由不提供 DHCP 服务，否则会和主路由抢着发地址
uci -q set dhcp.lan.ignore='1'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ra='disabled'
uci -q commit dhcp

# 放行 lan 侧管理访问；值必须裸写，套引号会被当成字面量 'ACCEPT' 而失效
lan_zone="$(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='lan'$/\1/p" | head -n 1)"
if [ -n "$lan_zone" ]; then
	uci -q set "firewall.${lan_zone}.input=ACCEPT"
	uci -q set "firewall.${lan_zone}.output=ACCEPT"
	uci -q set "firewall.${lan_zone}.forward=ACCEPT"
	if [ "$NAT" -eq 1 ]; then
		uci -q set "firewall.${lan_zone}.masq=1"
	else
		uci -q set "firewall.${lan_zone}.masq=0"
	fi
	uci -q commit firewall
fi

/etc/init.d/network reload >/dev/null 2>&1 || true
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
/etc/init.d/firewall restart >/dev/null 2>&1 || true

echo "已应用。请用 http://$IP 重新访问（当前连接可能已断开）。"
