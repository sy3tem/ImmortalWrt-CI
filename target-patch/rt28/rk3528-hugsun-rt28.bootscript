part uuid ${devtype} ${devnum}:2 uuid

# Hugsun RT28: debug console on uart0 (ttyS0 @ 0xff9f0000, matches factory firmware)
setenv bootargs "coherent_pool=2M console=ttyS0,1500000 earlycon=uart8250,mmio32,0xff9f0000 root=PARTUUID=${uuid} rw rootwait";

load ${devtype} ${devnum}:1 ${fdt_addr_r} rockchip.dtb
load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img

booti ${kernel_addr_r} - ${fdt_addr_r}
