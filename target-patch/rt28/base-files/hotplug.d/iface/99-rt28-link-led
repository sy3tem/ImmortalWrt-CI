#!/bin/sh
# Link LED: blue when the WAN interface is up (online), yellow (red+green)
# when it is down (offline). All LEDs are active-low.
[ "$INTERFACE" = "wan" ] || exit 0

LED=/sys/class/leds

case "$ACTION" in
ifup)
	# online -> blue
	echo 1 > "$LED/link_blue/brightness"  2>/dev/null
	echo 0 > "$LED/link_red/brightness"   2>/dev/null
	echo 0 > "$LED/link_green/brightness" 2>/dev/null
	;;
ifdown)
	# offline -> yellow (red + green)
	echo 0 > "$LED/link_blue/brightness"  2>/dev/null
	echo 1 > "$LED/link_red/brightness"   2>/dev/null
	echo 1 > "$LED/link_green/brightness" 2>/dev/null
	;;
esac

exit 0
