#!/bin/sh
# SPDX-License-Identifier: MIT
#
# /etc/uci-defaults/99-mount-opt
#
# 京东云 亚瑟(RE-SS-01) / 雅典娜(RE-CS-02)：把 eMMC 上的大数据分区挂到 /opt。
#
# 背景：这两台的 eMMC 上有一个 ~110G 的 ext4 数据分区（本机实测是 mmcblk0p19）。
# 官方 fstab 里没有它，于是 block-mount 的 automount 把它挂到 /mnt/mmcblk0p19，
# /opt 就一直留在 1.9G 的 overlay 上 —— open-box(174M)、docker 数据全挤进去，
# overlay 满了就什么配置都存不下。
#
# 做法与 R28S 的 target-patch/r28s/opt-partition/99-auto-resize-and-mount-opt 一致：
# 写一条 fstab 条目把数据分区挂到 /opt，剩下交给 S11fstab 在开机时挂载。
# 与 R28S 的差别：这里的分区出厂就已经存在、也是 ext4，不需要 mkfs / 扩容。
#
# 只跑一次（uci-defaults 成功后自己删除）。任何一步失败都 exit 0：
# /opt 留在 overlay 上只是空间小，不值得把开机卡死。

. /lib/functions/uci-defaults.sh 2>/dev/null

log() { logger -t opt-partition "$*"; }

# 512-byte sectors per MiB；只认 >= 4 GiB 的 ext4 分区
# （rootfs 所在的 p18 是 2G，其余分区都是几十 M，天然被排除）
MIN_SECT=$((4 * 1024 * 1024 * 2))

BEST=""
BEST_SZ=0
for p in /dev/mmcblk0p*; do
	[ -b "$p" ] || continue
	[ "$(blkid -o value -s TYPE "$p" 2>/dev/null)" = "ext4" ] || continue
	sz=$(cat "/sys/class/block/${p##*/}/size" 2>/dev/null) || continue
	[ "${sz:-0}" -ge "$MIN_SECT" ] || continue
	if [ "$sz" -gt "$BEST_SZ" ]; then
		BEST="$p"
		BEST_SZ="$sz"
	fi
done

if [ -z "$BEST" ]; then
	log "没有找到 >=4GiB 的 ext4 数据分区，/opt 继续留在 overlay"
	exit 0
fi

UUID=$(blkid -o value -s UUID "$BEST" 2>/dev/null)
[ -n "$UUID" ] || { log "$BEST 没有 UUID，跳过"; exit 0; }

log "数据分区 $BEST (UUID=$UUID), $((BEST_SZ / 2048 / 1024)) GiB"

# ---- 1) fstab：已有该 uuid 的条目就改目标，没有就加一条 ------------------------
IDX=""
i=0
while uci -q get "fstab.@mount[$i]" >/dev/null 2>&1; do
	if [ "$(uci -q get "fstab.@mount[$i].uuid")" = "$UUID" ]; then
		IDX="$i"
		break
	fi
	i=$((i + 1))
done

if [ -n "$IDX" ]; then
	uci set "fstab.@mount[$IDX].target=/opt"
	uci set "fstab.@mount[$IDX].enabled=1"
else
	uci add fstab mount >/dev/null
	uci set "fstab.@mount[-1].uuid=$UUID"
	uci set "fstab.@mount[-1].target=/opt"
	uci set "fstab.@mount[-1].enabled=1"
fi
uci commit fstab || { log "fstab 写入失败，/opt 继续留在 overlay"; exit 0; }
log "fstab: $UUID -> /opt"

# ---- 2) 把 overlay 上的 /opt 内容搬进数据分区（升级上来的机器才有东西搬）-------
# 刷新固件时 /opt 基本是空的，这一整段直接跳过。
if [ -n "$(ls -A /opt 2>/dev/null)" ] && ! mountpoint -q /opt 2>/dev/null; then
	TMP=/mnt/.opt-migrate
	mkdir -p "$TMP" && mount "$BEST" "$TMP" 2>/dev/null
	if mountpoint -q "$TMP" 2>/dev/null; then
		log "把 /opt 现有内容搬到 $BEST（可能要一会儿）"
		ok=1
		for d in /opt/*; do
			[ -e "$d" ] || continue
			base=$(basename "$d")
			# 不碰数据分区里已有的同名目录以外的东西（lost+found 之类）
			[ "$base" = "lost+found" ] && continue
			cp -a "$d" "$TMP/" 2>/dev/null || ok=0
			[ -e "$TMP/$base" ] || ok=0
		done
		sync
		umount "$TMP" 2>/dev/null
		rmdir "$TMP" 2>/dev/null
		# 全部确实落到数据分区之后，才删 overlay 里的旧副本，省出 overlay 空间
		if [ "$ok" = "1" ]; then
			rm -rf /overlay/upper/opt/* 2>/dev/null
			log "迁移完成，overlay 上的旧副本已删除"
		else
			log "有文件没搬成功，overlay 上的副本保留（重启后 /opt 仍挂数据分区，旧副本不再可见）"
		fi
	fi
fi

# ---- 3) 如果这块分区已经被 automount 挂到别处（/mnt/...），先摘下来 -------------
# 正常情况下 S10 时还没挂，但 block hotplug 有可能抢在前面。
awk -v dev="$BEST" '$1 == dev { print $2 }' /proc/mounts 2>/dev/null | while read -r mp; do
	[ "$mp" = "/opt" ] && continue
	umount "$mp" 2>/dev/null && log "已从 $mp 摘掉 $BEST"
done

# fstab 的 S11fstab 会在本次开机里把 $BEST 挂到 /opt（我们的脚本在 S10boot 里跑）
exit 0
