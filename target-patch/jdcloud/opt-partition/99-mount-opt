#!/bin/sh
# SPDX-License-Identifier: MIT
#
# /etc/uci-defaults/99-mount-opt
#
# 京东云 亚瑟(RE-SS-01) / 雅典娜(RE-CS-02)：把 eMMC 上的大数据分区挂到 /opt。
#
# 两种来路都要能处理：
#   1) 从本仓库的固件升级上来 / 已经刷过带数据分区的版本 —— eMMC 上已有 p19 这块
#      ~110G 的 ext4，直接用它；
#   2) 从原厂固件刷过来 —— 原厂分区表里没有这块，eMMC 尾部是空闲空间，
#      这里自己补一个分区并 mkfs.ext4。
#
# 为什么要做：官方 fstab 里没有这块分区，block-mount 的 automount 会把它挂到
# /mnt/mmcblk0p19；/opt 就一直留在 1.9G 的 overlay 上 —— open-box(174M)、docker
# 数据全挤进去，overlay 满了什么都存不下。
#
# 做法与 R28S 的 target-patch/r28s/opt-partition/99-auto-resize-and-mount-opt 一致：
# 写好 fstab → /opt，剩下的交给 S11fstab 在开机时挂。区别是这里的分区可能要先建。
#
# 只跑一次（uci-defaults 成功后自己删除）。任何一步失败都 exit 0：
# /opt 留在 overlay 上只是空间小，不值得把开机搞挂。

. /lib/functions/uci-defaults.sh 2>/dev/null

MIN_SECT=$((4 * 1024 * 1024 * 2))   # 4 GiB，单位 = 512B 扇区
GPT_LINUX_GUID=0FC63DAF-8483-4772-8E79-3D69D8477DE4

log() { logger -t opt-partition "$*"; }

# 找出系统盘：优先用 cmdline 里 root=PARTUUID=... 对应的那块盘的整盘设备，
# 找不到再退回第一块 mmcblk/sd（亚瑟、雅典娜都是 /dev/mmcblk0，这里不写死）
detect_disk() {
	rootuuid=$(tr ' ' '\n' < /proc/cmdline 2>/dev/null | sed -n 's/^root=PARTUUID=//p' | head -1)
	if [ -n "$rootuuid" ]; then
		for p in /dev/mmcblk*p[0-9]* /dev/sd?[0-9]* /dev/nvme*n*p[0-9]*; do
			[ -b "$p" ] || continue
			[ "$(blkid -o value -s PARTUUID "$p" 2>/dev/null)" = "$rootuuid" ] || continue
			case "$p" in
			*mmcblk*p[0-9]*) echo "${p%p*}"; return 0 ;;
			/dev/nvme*)      echo "${p%p[0-9]*}"; return 0 ;;
			*)               echo "$(echo "$p" | sed -E 's/p?[0-9]+$//')"; return 0 ;;
			esac
		done
	fi
	for d in /sys/block/mmcblk* /sys/block/sd*; do
		case "$(basename "$d")" in *boot*|*rpmb*) continue ;; esac
		[ -b "/dev/$(basename "$d")" ] && { echo "/dev/$(basename "$d")"; return 0; }
	done
	echo /dev/mmcblk0
}

DISK=${OPT_DISK:-$(detect_disk)}

disk_name() { basename "$DISK"; }
disk_sectors() { cat "/sys/class/block/$(disk_name)/size" 2>/dev/null; }
disk_pttype() { blkid -o value -s PTTYPE "$DISK" 2>/dev/null; }

# 分区表里最后一个分区的结束扇区（+1）
last_end() {
	sfdisk -d "$DISK" 2>/dev/null | \
		sed -n 's/.*start=[ ]*\([0-9]*\), size=[ ]*\([0-9]*\).*/\1 \2/p' | \
		awk '{ if ($1 + $2 > m) m = $1 + $2 } END { print m + 0 }'
}

part_size() { cat "/sys/class/block/$(basename "$1")/size" 2>/dev/null; }

# 已有的大 ext4 数据分区（>= 4 GiB），没有就输出空
find_data_part() {
	best=""
	best_sz=0
	for p in "${DISK}"p*; do
		[ -b "$p" ] || continue
		[ "$(blkid -o value -s TYPE "$p" 2>/dev/null)" = "ext4" ] || continue
		sz=$(part_size "$p") || continue
		[ "${sz:-0}" -ge "$MIN_SECT" ] || continue
		if [ "$sz" -gt "$best_sz" ]; then best="$p"; best_sz="$sz"; fi
	done
	echo "$best"
}

# 有 ≥4GiB、但还没格式化的分区（原厂有时会留一块空的分区），格成 ext4 拿来用
claim_blank_part() {
	command -v mkfs.ext4 >/dev/null 2>&1 || { log "缺 mkfs.ext4，跳过未格式化分区"; return 1; }
	best=""
	best_sz=0
	for p in "${DISK}"p*; do
		[ -b "$p" ] || continue
		# 已有文件系统的一律不碰
		[ -n "$(blkid -o value -s TYPE "$p" 2>/dev/null)" ] && continue
		sz=$(part_size "$p") || continue
		[ "${sz:-0}" -ge "$MIN_SECT" ] || continue
		# 还挂着的当然不碰
		awk -v dev="$p" '$1 == dev { f=1 } END { exit !f }' /proc/mounts && continue
		if [ "$sz" -gt "$best_sz" ]; then best="$p"; best_sz="$sz"; fi
	done
	[ -n "$best" ] || return 1
	log "发现未格式化的 $best（$((best_sz / 2048 / 1024)) GiB），格式化成 ext4 label=opt"
	mkfs.ext4 -F -L opt "$best" >/dev/null 2>&1 || { log "mkfs.ext4 $best 失败"; return 1; }
	echo "$best"
}

# 在空闲空间里补一个分区并格式化；成功输出新设备名
create_data_part() {
	command -v sfdisk >/dev/null 2>&1 || { log "缺 sfdisk，无法建分区"; return 1; }
	command -v mkfs.ext4 >/dev/null 2>&1 || { log "缺 mkfs.ext4，无法建分区"; return 1; }

	total=$(disk_sectors)
	[ -n "$total" ] || { log "读不到 $DISK 容量"; return 1; }

	# GPT 末尾要留 34 个扇区给 backup header + entries
	end=$(last_end)
	case "$(disk_pttype)" in
	gpt|GPT) reserve=34 ;;
	*)       reserve=0 ;;
	esac

	start=$((end + 1))
	# 对齐到 1 MiB（所有分区起点都是 2048 的倍数），空盘时也别从 1 号扇区开始
	if [ "$start" -lt 2048 ]; then start=2048; fi
	free=$((total - start - reserve))
	if [ "$free" -lt "$MIN_SECT" ]; then
		log "$DISK 尾部空闲不足 4GiB（$((free / 2048)) MiB），不建分区"
		return 1
	fi

	case "$(disk_pttype)" in
	gpt|GPT) type="$GPT_LINUX_GUID" ;;
	*)       type=83 ;;
	esac

	log "在 $DISK 上新建分区: start=$start size=$free type=$type"
	if ! printf 'start=%s, size=%s, type=%s, name="opt"\n' "$start" "$free" "$type" | \
		sfdisk --append "$DISK" >/dev/null 2>&1; then
		log "sfdisk --append 失败"
		return 1
	fi

	NUM=$(sfdisk -d "$DISK" 2>/dev/null | sed -n 's|^/dev/.*p\([0-9]*\) *:.*|\1|p' | sort -n | tail -1)
	[ -n "$NUM" ] || { log "建完分区读不到分区号"; return 1; }
	NEW="${DISK}p${NUM}"

	# 让内核认这块新分区（不重读整张表，根分区还挂着）
	partx -a -n "$NUM" "$DISK" >/dev/null 2>&1 || \
		blockdev --rereadpt "$DISK" >/dev/null 2>&1 || true

	i=0
	while [ ! -b "$NEW" ] && [ "$i" -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done
	if [ ! -b "$NEW" ]; then
		# 没有 devtmpfs/mdev 时节点可能没自动建出来，按 sysfs 里的 major:minor 补
		majmin=$(cat "/sys/class/block/$(basename "$NEW")/dev" 2>/dev/null)
		[ -n "$majmin" ] && mknod "$NEW" b "${majmin%%:*}" "${majmin##*:}" 2>/dev/null
		sleep 1
	fi
	[ -b "$NEW" ] || { log "分区节点 $NEW 没出现"; return 1; }

	if ! mkfs.ext4 -F -L opt "$NEW" >/dev/null 2>&1; then
		log "mkfs.ext4 $NEW 失败"
		return 1
	fi
	log "已创建 $NEW ($((free / 2048 / 1024)) GiB, label=opt)"
	echo "$NEW"
}

main() {
	log "系统盘 $DISK，开始找 /opt 数据分区"

	BEST=$(find_data_part)
	if [ -z "$BEST" ]; then
		# 有些机器 rootfs 和 eMMC 不是同一块盘（NAND + eMMC 双存储）：
		# 系统盘上没有，就看看别的盘上有没有现成的大 ext4
		for d in /sys/block/mmcblk* /sys/block/sd*; do
			n=$(basename "$d")
			case "$n" in *boot*|*rpmb*) continue ;; esac
			[ "$n" = "$(basename "$DISK")" ] && continue
			[ -b "/dev/$n" ] || continue
			cand=$(DISK="/dev/$n"; find_data_part)
			if [ -n "$cand" ]; then
				log "系统盘上没有，改用另一块盘的 $cand"
				BEST="$cand"
				DISK="/dev/$n"
				break
			fi
		done
	fi
	if [ -z "$BEST" ]; then
		log "$DISK 上没有 >=4GiB 的 ext4 数据分区，看看有没有未格式化的"
		BEST=$(claim_blank_part)
	fi
	if [ -z "$BEST" ]; then
		log "也没有现成可用的分区，尝试在空闲空间新建"
		BEST=$(create_data_part)
	fi
	[ -n "$BEST" ] || { log "没有可用的数据分区，/opt 继续留在 overlay"; return 0; }

	UUID=$(blkid -o value -s UUID "$BEST" 2>/dev/null)
	[ -n "$UUID" ] || { log "$BEST 没有 UUID，跳过"; return 0; }
	log "数据分区 $BEST (UUID=$UUID)"

	# ---- 1) fstab：已有该 uuid 的条目就改目标，没有就加一条 ----
	IDX=""
	i=0
	while uci -q get "fstab.@mount[$i]" >/dev/null 2>&1; do
		if [ "$(uci -q get "fstab.@mount[$i].uuid")" = "$UUID" ]; then IDX="$i"; break; fi
		i=$((i + 1))
	done
	if [ -n "$IDX" ]; then
		uci set "fstab.@mount[$IDX].target=/opt"
		uci set "fstab.@mount[$IDX].enabled=1"
	else
		uci add fstab mount >/dev/null
		uci set "fstab.@mount[-1].uuid=$UUID"
		uci set "fstab.@mount[-1].target=/opt"
		uci set "fstab.@mount[-1].enabled=1"
	fi
	uci commit fstab || { log "fstab 写入失败"; return 0; }
	log "fstab: $UUID -> /opt"

	# ---- 2) 把 overlay 上的 /opt 内容搬进数据分区（升级上来的机器才有东西搬）----
	if [ -n "$(ls -A /opt 2>/dev/null)" ] && ! mountpoint -q /opt 2>/dev/null; then
		TMP=/mnt/.opt-migrate
		mkdir -p "$TMP" && mount "$BEST" "$TMP" 2>/dev/null
		if mountpoint -q "$TMP" 2>/dev/null; then
			log "把 /opt 现有内容搬到 $BEST（可能要一会儿）"
			ok=1
			for d in /opt/*; do
				[ -e "$d" ] || continue
				base=$(basename "$d")
				[ "$base" = "lost+found" ] && continue
				cp -a "$d" "$TMP/" 2>/dev/null || ok=0
				[ -e "$TMP/$base" ] || ok=0
			done
			sync
			umount "$TMP" 2>/dev/null
			rmdir "$TMP" 2>/dev/null
			if [ "$ok" = "1" ]; then
				rm -rf /overlay/upper/opt/* 2>/dev/null
				log "迁移完成，overlay 上的旧副本已删除"
			else
				log "有文件没搬成功，overlay 上的副本保留"
			fi
		fi
	fi

	# ---- 3) 万一已经被 automount 挂到别处（/mnt/...），先摘掉 ----
	awk -v dev="$BEST" '$1 == dev { print $2 }' /proc/mounts 2>/dev/null | while read -r mp; do
		[ "$mp" = "/opt" ] && continue
		umount "$mp" 2>/dev/null && log "已从 $mp 摘掉 $BEST"
	done

	# fstab 的 S11fstab 会在本次开机里把它挂到 /opt（本脚本跑在 S10boot）
	return 0
}

[ "${OPT_LIB:-0}" = "1" ] || main
